# Directus 11 environment configuration.
# Copy this file to .env and adjust the values for your machine:
#   cp .env.example .env
# Every variable below is optional: the defaults shown here are the values
# docker-compose.yml falls back to when a variable is not set.

# ---------------------------------------------------------------------------
# Directus application
# ---------------------------------------------------------------------------

# Port exposed on the host for the Directus server (default: 8055).
DIRECTUS_PORT=8055

# Secret used for both Directus KEY and SECRET (default: dev-secret-change-me).
# Change this to a long random string before deploying anywhere real.
DIRECTUS_SECRET=dev-secret-change-me

# Admin account created on first boot (default: admin@example.com / admin1234).
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=admin1234

# ---------------------------------------------------------------------------
# PostgreSQL database
# ---------------------------------------------------------------------------

# Port exposed on the host for PostgreSQL (default: 5432).
DIRECTUS_DB_PORT=5432

# Database name, user, and password shared by the db service and Directus
# (default: directus / directus / directus).
DIRECTUS_DB_DATABASE=directus
DIRECTUS_DB_USER=directus
DIRECTUS_DB_PASSWORD=directus
